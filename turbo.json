{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ADMIN_DATABASE_URL",
    "APP_DB_USER",
    "APP_DB_PASSWORD",
    "TENANT_ID",
    "TENANT_NAME",
    "TENANT_TAGLINE",
    "TENANT_CHARITY_NUMBER",
    "SESSION_SECRET",
    "SETUP_TOKEN",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
