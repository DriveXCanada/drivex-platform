# ---------------------------------------------------------------------------
# VETS Canada (DriveX platform) — environment template
# Copy to .env.local for local dev; set the same keys in Railway → Variables
# for production. NEVER commit real values — only this .example file is tracked.
# ---------------------------------------------------------------------------

# Which tenant this deployment serves. Every DB row is scoped to it.
TENANT_ID=vets-canada
TENANT_NAME="VETS Canada — Dartmouth"
# Branding printed on receipts and reports for THIS organization.
# Leave the charity number blank if the org isn't a registered charity.
TENANT_TAGLINE="Proudly Supported by DriveX"
TENANT_CHARITY_NUMBER=828604041RR0001

# Superuser connection string. Used ONLY for one-time database bootstrap:
# creating the schema, RLS policies, and the application role. Never used for
# ordinary request-time queries.
ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# Application role. The running app connects as this NON-superuser role so
# Postgres Row-Level Security is actually enforced. The bootstrap step creates
# this role using APP_DB_USER / APP_DB_PASSWORD.
APP_DB_USER=vets_app
APP_DB_PASSWORD=generate-a-strong-random-password
DATABASE_URL=postgresql://vets_app:APP_DB_PASSWORD@HOST:PORT/railway

# Session signing secret (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-32-plus-character-random-secret

# Secret that gates the privileged /api/setup bootstrap endpoint. Required to
# run database setup/migrations. Keep it secret; rotate if leaked. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SETUP_TOKEN=generate-a-random-setup-token
